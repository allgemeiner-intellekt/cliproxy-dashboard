{
  // Type-checks the frontend tests (run by `bun test`), which the app config
  // leaves out of the bundle build.
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": ["bun", "vite/client"]
  },
  "include": ["src"],
  "exclude": []
}
