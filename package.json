{
  "name": "cliproxy-dashboard",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint --deny-warnings",
    "test": "bun test ./server ./deploy && bun test ./src",
    "preview": "vite preview",
    "server": "bun server/src/index.ts",
    "server:check": "tsc -p server/tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "backup": "bun server/src/backup.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.22"
  },
  "devDependencies": {
    "@fontsource-variable/public-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@happy-dom/global-registrator": "^21.0.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.11",
    "lucide-react": "^1.48.0",
    "oxlint": "^1.81.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
